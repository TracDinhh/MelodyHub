<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>MelodyHub Backend</display-name>

    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.melodyHub.filter.CorsFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.auth.AuthServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>SongServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.song.SongServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>PublicArtistServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.artist.PublicArtistServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.admin.AdminServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>UploadServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.upload.UploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>31457280</max-file-size>
            <max-request-size>33554432</max-request-size>
            <file-size-threshold>262144</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet>
        <servlet-name>ListenHistoryServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.listen.ListenHistoryServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>PlaylistServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.playlist.PlaylistServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.user.UserServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>LikeServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.song.LikeServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>PaymentServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.payment.PaymentServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>StudioServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.studio.StudioServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>MeServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.user.MeServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ArtistAccessRequestServlet</servlet-name>
        <servlet-class>com.melodyHub.controller.artist.ArtistAccessRequestServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SongServlet</servlet-name>
        <url-pattern>/api/songs/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>PublicArtistServlet</servlet-name>
        <url-pattern>/api/artists/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/api/admin/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>UploadServlet</servlet-name>
        <url-pattern>/api/uploads/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ListenHistoryServlet</servlet-name>
        <url-pattern>/api/listens/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>PlaylistServlet</servlet-name>
        <url-pattern>/api/playlists/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/api/users/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LikeServlet</servlet-name>
        <url-pattern>/api/likes/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/api/payments/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>StudioServlet</servlet-name>
        <url-pattern>/api/studio/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>MeServlet</servlet-name>
        <url-pattern>/api/me/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ArtistAccessRequestServlet</servlet-name>
        <url-pattern>/api/artist-access-requests/*</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
